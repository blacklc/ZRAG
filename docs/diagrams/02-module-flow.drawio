<mxGraphModel adaptiveColors="auto">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>

    <mxCell id="outer" value="ZRAG 模块逻辑流程" style="swimlane;startSize=30;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;html=1;" vertex="1" parent="1">
      <mxGeometry x="0" y="0" width="900" height="700" as="geometry"/>
    </mxCell>

    <mxCell id="ingest-lane" value="摄入流程 (离线): Source → Chunk → Embed → Store" style="swimlane;horizontal=0;startSize=110;fillColor=#e8f5e9;html=1;fontStyle=1;" vertex="1" parent="outer">
      <mxGeometry x="20" y="40" width="860" height="150" as="geometry"/>
    </mxCell>
    <mxCell id="n-source" value="DocumentSource&#xa;macOS Notes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;fontStyle=1;" vertex="1" parent="ingest-lane">
      <mxGeometry x="30" y="45" width="140" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="n-chunk" value="ChunkingStrategy&#xa;分块" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;fontStyle=1;" vertex="1" parent="ingest-lane">
      <mxGeometry x="230" y="45" width="140" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="n-embed" value="BgeSmallEmbedder&#xa;向量化 (384维)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;fontStyle=1;" vertex="1" parent="ingest-lane">
      <mxGeometry x="430" y="45" width="160" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="n-sqlite-write" value="SQLite 事务写入&#xa;chunks + FTS5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;fontStyle=1;" vertex="1" parent="ingest-lane">
      <mxGeometry x="650" y="28" width="150" height="45" as="geometry"/>
    </mxCell>
    <mxCell id="n-chroma-write" value="ChromaDB 写入&#xa;向量存储" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;fontStyle=1;" vertex="1" parent="ingest-lane">
      <mxGeometry x="650" y="85" width="150" height="45" as="geometry"/>
    </mxCell>
    <mxCell id="e-i1" edge="1" parent="ingest-lane" source="n-source" target="n-chunk" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e-i2" edge="1" parent="ingest-lane" source="n-chunk" target="n-embed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e-i3" edge="1" parent="ingest-lane" source="n-embed" target="n-sqlite-write" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e-i4" edge="1" parent="ingest-lane" source="n-sqlite-write" target="n-chroma-write" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <mxCell id="sync-lane" value="增量判断" style="swimlane;horizontal=0;startSize=110;fillColor=#fce4ec;html=1;fontStyle=1;" vertex="1" parent="outer">
      <mxGeometry x="20" y="200" width="860" height="80" as="geometry"/>
    </mxCell>
    <mxCell id="n-hash-check" value="content_hash 对比?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;fontStyle=1;" vertex="1" parent="sync-lane">
      <mxGeometry x="350" y="10" width="140" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="e-skip" edge="1" parent="outer" source="n-chroma-write" target="n-hash-check" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="n-skip" value="相同 → 跳过" style="text;whiteSpace=wrap;html=1;fillColor=#f8cecc;" vertex="1" parent="sync-lane">
      <mxGeometry x="530" y="20" width="110" height="40" as="geometry"/>
    </mxCell>

    <mxCell id="query-lane" value="查询流程 (在线): Embed → Hybrid Search → RRF → Prompt → LLM" style="swimlane;horizontal=0;startSize=110;fillColor=#e8f4f8;html=1;fontStyle=1;" vertex="1" parent="outer">
      <mxGeometry x="20" y="300" width="860" height="160" as="geometry"/>
    </mxCell>
    <mxCell id="n-query" value="用户提问" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;fontStyle=1;" vertex="1" parent="query-lane">
      <mxGeometry x="30" y="55" width="120" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="n-embed-q" value="Embed Query" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;fontStyle=1;" vertex="1" parent="query-lane">
      <mxGeometry x="200" y="55" width="120" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="n-hybrid" value="Hybrid Search&#xa;(ChromaDB + FTS5)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;fontStyle=1;" vertex="1" parent="query-lane">
      <mxGeometry x="370" y="55" width="160" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="n-rrf" value="RRF 融合&#xa;k=60" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;fontStyle=1;" vertex="1" parent="query-lane">
      <mxGeometry x="580" y="55" width="120" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="n-prompt" value="PromptBuilder&#xa;构建 Prompt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;fontStyle=1;" vertex="1" parent="query-lane">
      <mxGeometry x="15" y="95" width="140" height="50" as="geometry"/>
    </mxCell>
    <mxCell id="n-llm-call" value="LLM.chat()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;fontStyle=1;" vertex="1" parent="query-lane">
      <mxGeometry x="200" y="95" width="120" height="50" as="geometry"/>
    </mxCell>
    <mxCell id="n-conv-write" value="存会话 + 消息" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;fontStyle=1;" vertex="1" parent="query-lane">
      <mxGeometry x="370" y="95" width="140" height="50" as="geometry"/>
    </mxCell>
    <mxCell id="n-answer" value="返回回答 + Sources" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;fontStyle=1;" vertex="1" parent="query-lane">
      <mxGeometry x="580" y="95" width="160" height="50" as="geometry"/>
    </mxCell>
    <mxCell id="e-q1" edge="1" parent="query-lane" source="n-query" target="n-embed-q" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e-q2" edge="1" parent="query-lane" source="n-embed-q" target="n-hybrid" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e-q3" edge="1" parent="query-lane" source="n-hybrid" target="n-rrf" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e-q4" edge="1" parent="query-lane" source="n-rrf" target="n-prompt" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e-q5" edge="1" parent="query-lane" source="n-prompt" target="n-llm-call" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e-q6" edge="1" parent="query-lane" source="n-llm-call" target="n-conv-write" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e-q7" edge="1" parent="query-lane" source="n-conv-write" target="n-answer" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <mxCell id="llm-note" value="LLM 调用在事务外&#xa;失败 → 零副作用" style="text;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#e57373;fontStyle=1;" vertex="1" parent="query-lane">
      <mxGeometry x="740" y="28" width="100" height="50" as="geometry"/>
    </mxCell>

    <mxCell id="conversation-lane" value="会话持久化 (SQLite)" style="swimlane;horizontal=0;startSize=110;fillColor=#fff0e6;html=1;fontStyle=1;" vertex="1" parent="outer">
      <mxGeometry x="20" y="480" width="860" height="100" as="geometry"/>
    </mxCell>
    <mxCell id="n-conv" value="conversations 表" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#fff2cc;fontStyle=1;" vertex="1" parent="conversation-lane">
      <mxGeometry x="200" y="25" width="160" height="55" as="geometry"/>
    </mxCell>
    <mxCell id="n-msg" value="messages 表" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#fff2cc;fontStyle=1;" vertex="1" parent="conversation-lane">
      <mxGeometry x="500" y="25" width="160" height="55" as="geometry"/>
    </mxCell>
    <mxCell id="e-c1" edge="1" parent="outer" source="n-conv-write" target="n-conv" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;dashed=1;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e-c2" edge="1" parent="outer" source="n-conv" target="n-msg" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <mxCell id="legend-container" value="图例" style="swimlane;startSize=24;fillColor=#f5f5f5;strokeColor=#bdbdbd;html=1;fontStyle=1;" vertex="1" parent="outer">
      <mxGeometry x="20" y="600" width="860" height="80" as="geometry"/>
    </mxCell>
    <mxCell id="leg-ingest" value="摄入流程节点" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;" vertex="1" parent="legend-container">
      <mxGeometry x="30" y="20" width="120" height="40" as="geometry"/>
    </mxCell>
    <mxCell id="leg-query" value="查询流程节点" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;" vertex="1" parent="legend-container">
      <mxGeometry x="180" y="20" width="120" height="40" as="geometry"/>
    </mxCell>
    <mxCell id="leg-storage" value="存储层节点" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;" vertex="1" parent="legend-container">
      <mxGeometry x="330" y="20" width="120" height="40" as="geometry"/>
    </mxCell>
    <mxCell id="leg-output" value="输出节点" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;" vertex="1" parent="legend-container">
      <mxGeometry x="480" y="20" width="120" height="40" as="geometry"/>
    </mxCell>
    <mxCell id="leg-db" value="数据库" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#fff2cc;" vertex="1" parent="legend-container">
      <mxGeometry x="630" y="15" width="100" height="50" as="geometry"/>
    </mxCell>
    <mxCell id="leg-decision" value="判断" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;" vertex="1" parent="legend-container">
      <mxGeometry x="750" y="20" width="80" height="40" as="geometry"/>
    </mxCell>
  </root>
</mxGraphModel>