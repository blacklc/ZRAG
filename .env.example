# =============================================================================
# ZRAG 环境变量模板 (项目根目录)
#
# 将此文件复制为 .env 并填入实际值即可使用。
# 注意: frontend/.env.example 是前端构建模板, 与此文件用途不同。
# =============================================================================

# === API 鉴权（必需） ===
# ZRAG_API_KEY 用于前端与后端 API 之间的请求认证
ZRAG_API_KEY=your-api-key-here
# LITELLM_MASTER_KEY 用于 litellm gateway 管理接口认证
LITELLM_MASTER_KEY=your-litellm-key-here

# === LLM Gateway 配置 ===
# 容器部署时使用 host.docker.internal 访问宿主机上的 litellm
LLM_GATEWAY_URL=http://host.docker.internal:4000/v1
# 所使用的模型名称, smart-router 为 litellm 自动路由
LLM_GATEWAY_MODEL=smart-router

# === Embedding 模型目录 ===
# 宿主机模型缓存目录（docker compose 挂载到容器内 /app/models）
# 已预装 BAAI/bge-small-zh-v1.5, 默认挂载项目根目录下的 ./models
# MODELS_DIR_HOST=./models
# 容器内模型路径:
#   /app/models/
MODELS_DIR=/app/models

# === Django 安全配置 ===
# 使用以下命令生成随机密钥: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=<run-python-command-above>
# 生产环境务必设为 False
DJANGO_DEBUG=False
# 允许访问的主机名, 多个以逗号分隔
DJANGO_ALLOWED_HOSTS=localhost
# 时区设置
DJANGO_TIME_ZONE=Asia/Shanghai
